# ---- LLM providers (Phase III fallback chain) ----
# Tier 1
GEMINI_API_KEY=
# Tier 2
GROQ_API_KEY=
# Tier 3 (OpenRouter recommended: one key -> many models)
OPENROUTER_API_KEY=
# Optional direct DeepSeek instead of / alongside OpenRouter
DEEPSEEK_API_KEY=

# ---- GitHub (Phase I: research paper star counts + rate limit headroom) ----
GITHUB_TOKEN=

# ---- Product Hunt (Phase I: products vertical) ----
# Developer token from https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=

# ---- Google Sheets output sink (deliverable) ----
# Path to the service-account JSON downloaded from Google Cloud
GOOGLE_SERVICE_ACCOUNT_JSON=./config/gcp-service-account.json
# The spreadsheet key (the long id in the sheet URL) — created/shared with the service account email
GSHEET_ID=

# ---- Optional: anti-bot (Phase V) ----
# Single rotating proxy endpoint, e.g. http://user:pass@gate.provider.com:7000
PROXY_URL=
# Or a scraping API key (ScraperAPI / ScrapingBee / Zyte)
SCRAPER_API_KEY=

# ---- Runtime tuning ----
LOG_LEVEL=INFO
